#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

if ! command -v mise >/dev/null 2>&1; then
  echo "mise not installed; skipping corepack disable."
  exit 0
fi

if ! mise which node >/dev/null 2>&1; then
  echo "Node not installed via mise; skipping corepack disable."
  exit 0
fi

NODE_ROOT="$(mise where node)"

if [[ ! -e "$NODE_ROOT/bin/corepack" ]]; then
  echo "corepack not found under $NODE_ROOT; skipping."
  exit 0
fi

export PATH="$NODE_ROOT/bin:$PATH"
corepack disable
echo "corepack disabled for $(node --version); pnpm comes from mise, not Corepack."
